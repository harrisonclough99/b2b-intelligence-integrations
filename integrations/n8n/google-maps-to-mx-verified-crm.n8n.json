      "notes": "Extracts local businesses, crawls their websites for MX-verified emails, CMS & ad pixels."
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{Boolean($json.verified_emails || $json.verified_contacts || $json.verified_role_emails || $json.price_usd || $json.npi_number)}}",
              "value2": true
            }
